# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=1h
CORS_ALLOWED_ORIGINS=http://localhost:5500
# Optional: creates the first ADMIN account on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: email notifications for contact messages (SMTP, e.g. a Gmail app password)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
CONTACT_NOTIFY_TO=
CONTACT_MAIL_FROM=
# Logging: prod writes JSON lines; set SPRING_PROFILES_ACTIVE= (empty) for readable text
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL=info
